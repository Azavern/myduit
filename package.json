{
  "name": "myduit",
  "version": "0.1.0",
  "private": true,
  "description": "Web pencatatan keuangan multiuser (prototipe pribadi nonkomersial)",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.0.0"
  },

  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "env:check": "node scripts/check-env.mjs",
    "secrets:generate": "node scripts/local/generate-secrets.mjs",
    "db:generate": "supabase migration new",
    "db:migrate": "supabase migration up --local",
    "setup": "node scripts/setup.mjs",
    "bootstrap:owner": "node scripts/bootstrap-owner.mjs",
    "auth:reset": "node scripts/create-reset-token.mjs",
    "db:backup": "node scripts/backup.mjs"
  },
  "dependencies": {
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "csv-stringify": "6.9.0",
    "decimal.js": "10.6.0",
    "next": "16.4.0",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
