# =============================================================================
# .env.example — template variabel lingkungan myduit
#
# Salin menjadi `.env.local` (lokal) atau isi lewat Environment Variables di
# Vercel (preview/production). JANGAN pernah commit nilai asli.
# Placeholder kosong di bawah adalah contoh, bukan nilai default yang boleh
# dipakai deployment.
# =============================================================================

# WAJIB — URL origin aplikasi. Lokal: http://localhost:3000.
# Production: URL HTTPS deployment Vercel. Preview: origin preview terkait.
# Dipakai server untuk validasi Origin/CSRF dan pembuatan tautan;
# bukan secret, jadi boleh diketahui browser.
APP_URL=http://localhost:3000

# WAJIB — label lingkungan: local, preview, production.
# Menjadi guard setup/migration dan pemisahan data; bukan pengganti NODE_ENV.
APP_ENV=local

# WAJIB runtime — connection string PostgreSQL role `finance_runtime`.
# Ambil host/port/project ref dari Supabase > Connect > Transaction pooler.
# Gunakan user role custom, password hasil provisioning, dan TLS valid.
# Percent-encode password pada URL. SERVER ONLY; jangan beri prefix NEXT_PUBLIC_.
DATABASE_URL=

# HANYA LOKAL/JOB MIGRATION — connection string admin untuk setup/migration/backup.
# Ambil dari Supabase > Connect; gunakan direct connection atau session pooler
# sesuai jaringan yang tersedia. Memiliki hak tinggi.
# JANGAN pasang variabel ini di runtime Vercel.
DATABASE_ADMIN_URL=

# WAJIB runtime — 32 byte acak dalam format hex (64 karakter).
# Jalankan `pnpm secrets:generate`; hasil tersimpan di .secrets/generated.env.
# Dipakai untuk HMAC token sesi/undangan/reset dan bucket rate limit keamanan.
# SERVER ONLY. Gunakan nilai berbeda untuk local/preview/production;
# jangan rotasi nilai ini saat build.
AUTH_TOKEN_PEPPER=

# HANYA SETUP — password acak role DB finance_runtime, hex 64 karakter.
# Dibuat oleh generator; dipakai `pnpm setup` untuk membuat role dan menyusun
# DATABASE_URL. Setelah DATABASE_URL siap, variabel ini tidak dibutuhkan runtime.
DB_RUNTIME_PASSWORD=

# OPSIONAL (setup remote) — template Transaction pooler dari Supabase > Connect,
# TANPA password. Contoh:
#   postgresql://finance_runtime.PROJECTREF@aws-0-REGION.pooler.supabase.com:6543/postgres
# Dipakai `pnpm setup` untuk menyusun DATABASE_URL ber-password di lingkungan
# operator. Kosongkan bila Anda mengisi DATABASE_URL secara manual.
DATABASE_POOLER_URL=

# OPSIONAL — timezone default untuk workspace baru; tidak mengubah histori
# workspace yang sudah ada. Nilai harus nama IANA yang valid.
DEFAULT_TIMEZONE=Asia/Makassar

# OPSIONAL — batas koneksi per proses Node; awal 2. Ukur sebelum menaikkan.
DATABASE_POOL_MAX=2

# OPSIONAL — sesi absolut dan idle dalam jam; server menerapkan batas yang aman.
SESSION_ABSOLUTE_HOURS=168
SESSION_IDLE_HOURS=24

# OPSIONAL — debug/info/warn/error. JANGAN mencatat body password, cookie,
# atau URL token.
LOG_LEVEL=info

# HANYA SKRIP OPERATOR — dipakai `pnpm bootstrap:owner` tanpa prompt interaktif.
# Kosongkan agar skrip meminta input. Jangan pasang di runtime Vercel.
# OWNER_EMAIL=
# OWNER_NAME=
# OWNER_PASSWORD=
